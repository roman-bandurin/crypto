{
  "name": "crypto",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --build --force",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint . --tsconfig=./tsconfig.json",
    "lint:fix": "vp lint . --tsconfig=./tsconfig.json --fix",
    "knip": "knip",
    "context": "node scripts/build-context.mjs",
    "repomix": "repomix",
    "repomix:skill": "repomix --skill-generate crypto-project-reference --skill-output .claude/skills/crypto-project-reference --force --quiet",
    "prepare": "vp config"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@vueuse/core": "^15.0.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vuetify": "^4.2.4"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.6",
    "knip": "^6.41.0",
    "npm-run-all2": "^8.0.4",
    "repomix": "^1.18.1",
    "sass-embedded": "^1.105.1",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-plus": "1.2.0",
    "vitest": "5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4"
  }
}
